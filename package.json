{
  "name": "campflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @campflare/server dev",
    "dev:all": "node scripts/dev.ts",
    "otui": "scripts/otui.sh",
    "web": "pnpm --filter @campflare/web dev",
    "shot": "pnpm --filter @campflare/web shot",
    "e2e": "pnpm --filter @campflare/web e2e",
    "desktop": "pnpm --filter @campflare/desktop dev",
    "ready": "node scripts/ready.ts",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm -r test",
    "test:live": "pnpm --filter @campflare/live test:live",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0"
}
