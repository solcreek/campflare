SIGNING_KEY=dev-signing-key-change-me
BOOTSTRAP_SECRET=dev-bootstrap
# Huddles (off while these are empty): a Realtime SFU app, and optionally a TURN key.
# cf realtime sfu apps create --name campflare-dev   → uid, secret
# cf realtime turn keys create --name campflare-dev  → uid, secret
REALTIME_APP_ID=
REALTIME_APP_SECRET=
REALTIME_TURN_KEY_ID=
REALTIME_TURN_KEY_TOKEN=
# Huddle transcription (off while these are empty): Workers AI over REST, with an account token
# scoped to Workers AI Read (cf accounts tokens create), and the public origin the
# SFU connects back to (in development, a tunnel: cloudflared tunnel --url http://localhost:8787).
CF_ACCOUNT_ID=
WORKERS_AI_TOKEN=
HUDDLE_PUBLIC_URL=
# Where the app is served: permalinks (/archives/...) redirect there. pnpm dev:all sets it
# (the --web app, or http://localhost:5173 for pnpm web); set it here to point elsewhere.
APP_URL=
# "true": permalinks answer a page offering the desktop app (campflare://) and the
# browser, instead of redirecting to APP_URL.
OFFER_DESKTOP_APP=
# Only for tests/live/images.live.test.ts (pnpm test:live), which runs the Worker with the real
# Images binding: an account API token with Workers Scripts: Edit and Images: Edit (with CF_ACCOUNT_ID).
IMAGES_API_TOKEN=
# Web Push (off while the keys are empty): pnpm ready --fix writes a pair here; pnpm vapid-keys prints one.
# VAPID_SUBJECT is a mailto: or https: contact for push services (the server's origin by default).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
